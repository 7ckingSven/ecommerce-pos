{
  "name": "tefc-ecommerce-tests",
  "version": "1.0.0",
  "description": "TEFC E-Commerce Web & Mobile Tests",
  "scripts": {
    "test": "jest",
    "test:web": "jest tests/web",
    "test:mobile": "jest tests/mobile",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "babel-jest": "^29.7.0",
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "transform": {
      "^.+\\.js$": "babel-jest"
    }
  }
}